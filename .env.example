# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# NOTIFICATION_SERVER_API_KEY: Optional API secret key for Render Notification Server.
# Can also be configured directly in Admin Panel UI or Firebase app_settings.
# NOTIFICATION_SERVER_API_KEY=YOUR_API_SECRET_KEY

