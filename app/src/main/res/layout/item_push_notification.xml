<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPushItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notification Title"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPushItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:backgroundTint="@color/tag_yellow_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="PENDING"
            android:textColor="@color/warning"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Message Body -->
    <TextView
        android:id="@+id/tvPushItemMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="Notification message details..."
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Optional Image URL display -->
    <TextView
        android:id="@+id/tvPushItemImageUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="🖼️ Image: https://..."
        android:textColor="@color/info"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Target Type & User Badge -->
    <TextView
        android:id="@+id/tvPushItemTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tag"
        android:backgroundTint="@color/tag_blue_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="🎯 Target: All Users"
        android:textColor="@color/info"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPushItemDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="17 Sep 2026, 12:30 PM"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnDeletePush"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_danger"
            android:contentDescription="Delete Push Notification"
            android:padding="8dp"
            android:src="@drawable/ic_trash"
            app:tint="@color/danger" />
    </LinearLayout>

</LinearLayout>
