<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/ivCategoryThumb"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="#15FFFFFF"
        android:scaleType="centerCrop"
        android:src="@drawable/app_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCategoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category Name"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCategoryId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.6"
            android:text="ID: key"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnEditCategory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_button_primary"
            android:contentDescription="Edit Category"
            android:src="@drawable/ic_edit"
            app:tint="@color/text_main" />

        <ImageButton
            android:id="@+id/btnDeleteCategory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_danger"
            android:contentDescription="Delete Category"
            android:src="@drawable/ic_trash"
            app:tint="@color/danger" />
    </LinearLayout>

</LinearLayout>
