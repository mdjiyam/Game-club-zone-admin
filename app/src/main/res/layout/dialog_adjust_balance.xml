<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="💰 ADJUST USER BALANCE"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogBalanceUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="User Name"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="DEPOSIT BALANCE (৳)"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogDeposit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input_field"
        android:hint="0"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_main"
        android:textColorHint="#40FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:text="WINNING BALANCE (৳)"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogWinning"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input_field"
        android:hint="0"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_main"
        android:textColorHint="#40FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelBalance"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_danger"
            android:text="CANCEL"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnSaveBalance"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="SAVE BALANCES"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
